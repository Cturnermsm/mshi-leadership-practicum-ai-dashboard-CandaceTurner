# --- CELL 1: Markdown ---
# # Leadership Impact Analysis: Diabetes and SDOH
# This notebook analyzes clinical and social indicators to provide actionable insights for MSM-CCN leadership.

# --- CELL 2: Code ---
import pandas as pd
import matplotlib.pyplot as plt

# Load the dataset
# Ensure your file is in the /data/ folder
df = pd.read_csv("../data/diabetes_012_health_indicators_BRFSS2015.csv")

# Display the first few rows
print("Data Preview:")
print(df.head())

# --- CELL 3: Markdown ---
# ## Descriptive Statistics
# We want to understand the average health profile of our population.

# --- CELL 4: Code ---
# Calculate the percentage of the population with High Blood Pressure
high_bp_pct = (df['HighBP'].mean() * 100)
print(f"Percentage with High Blood Pressure: {high_bp_pct:.2f}%")

# Group by Diabetes Status (0=No, 1=Prediabetes, 2=Diabetes) and look at Income
income_by_diabetes = df.groupby('Diabetes_012')['Income'].mean()
print("\nAverage Income Level by Diabetes Status (Scale 1-8):")
print(income_by_diabetes)

# --- CELL 5: Markdown ---
# ## Visualizing the Leadership Challenge
# The following chart shows the correlation between High Cholesterol and Diabetes.

# --- CELL 6: Code ---
# Visualization 1: High Cholesterol across Diabetes Groups
df.groupby('Diabetes_012')['HighChol'].mean().plot(kind='bar', color='skyblue')
plt.title('Prevalence of High Cholesterol by Diabetes Status')
plt.xlabel('Diabetes Status (0=None, 1=Pre, 2=Diabetes)')
plt.ylabel('Percentage with High Cholesterol')
plt.show()

