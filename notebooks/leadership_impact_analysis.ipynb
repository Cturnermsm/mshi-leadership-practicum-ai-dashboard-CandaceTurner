import pandas as pd
import matplotlib.pyplot as plt

# 1. Import data
df = pd.read_csv("../data/diabetes_012_health_indicators_BRFSS2015.csv")

# 2. Quick look
df.head()
df.info()
df.describe()

# 3. Basic descriptive stats for key variables
df['Diabetes_012'].value_counts(normalize=True) * 100
df['HighBP'].value_counts(normalize=True) * 100
df['HighChol'].value_counts(normalize=True) * 100
df['CholCheck'].value_counts(normalize=True) * 100
df['Smoker'].value_counts(normalize=True) * 100
df['PhysActivity'].value_counts(normalize=True) * 100
df['Fruits'].value_counts(normalize=True) * 100

df['BMI'].describe()
# Bar chart: distribution of diabetes status
df['Diabetes_012'].value_counts().sort_index().plot(kind='bar')
plt.xlabel('Diabetes Status (0=No, 1=Prediabetes, 2=Diabetes)')
plt.ylabel('Count')
plt.title('Distribution of Diabetes Status')
plt.show()

# Boxplot of BMI by diabetes status
df.boxplot(column='BMI', by='Diabetes_012')
plt.xlabel('Diabetes Status')
plt.ylabel('BMI')
plt.title('BMI by Diabetes Status')
plt.suptitle('')
plt.show()
